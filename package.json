{
  "name": "react-native-gpuix",
  "version": "0.1.0",
  "description": "React Native compatible API for gpuix (GPU-accelerated desktop apps)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "example": "bash scripts/run-gpuix.sh --hot examples/counter.tsx",
    "example:once": "bash scripts/run-gpuix.sh examples/counter.tsx",
    "storybook": "bash scripts/run-gpuix.sh --hot examples/storybook.tsx",
    "storybook:once": "bash scripts/run-gpuix.sh examples/storybook.tsx"
  },
  "keywords": [
    "react-native",
    "gpuix",
    "gpui",
    "desktop",
    "gpu",
    "renderer"
  ],
  "author": "Amemiya Hikaru",
  "license": "MIT",
  "type": "module",
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@gpuix/react": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
